[0.013953, "o", "$ toolcage inspect --module toy-server.wasm     # zero capabilities granted yet\r\n"]
[0.115667, "o", "server: toy-server (protocol 2025-06-18) - 7 tool(s)\r\n  echo  Echo the text argument back.\r\n  read_file  Read a file by path and return its contents.\r\n  write_file  Write text to a file by path.\r\n  env  Read an environment variable.\r\n  spin  Hostile: burn CPU forever.\r\n  shout  Hostile: emit megabytes of output.\r\n  counter  Increment a process-global counter and return its new value. Used to probe for state leakage across calls.\r\n"]
[0.117288, "o", "\r\n$ cat policy.yaml\r\n"]
[0.11867, "o", "version: 1\r\ndefaults:\r\n  timeout_ms: 20000\r\nunlisted_tools: deny\r\ntools:\r\n  echo: {}\r\n  read_file:\r\n    fs:\r\n      /data: { host: /tmp/tmp.sAUiRIGmTd/data, mode: ro }\r\n"]
[0.118809, "o", "\r\n$ toolcage check --policy policy.yaml\r\n"]
[0.120513, "o", "policy /tmp/tmp.sAUiRIGmTd/policy.yaml: 2 tool(s) listed (2 allowed, 0 denied), unlisted tools: deny\r\n  defaults: timeout 20000ms, fuel 2000000000, mem 256MB, output 4096KB, 0 env var(s), 0 mount(s)\r\n  echo: timeout 20000ms, fuel 2000000000, mem 256MB, output 4096KB, 0 env var(s), 0 mount(s)\r\n  read_file: timeout 20000ms, fuel 2000000000, mem 256MB, output 4096KB, 0 env var(s), 1 mount(s)\r\n    /data -> /tmp/tmp.sAUiRIGmTd/data (ro)\r\ncheck OK\r\n"]
[0.120751, "o", "\r\n$ toolcage run --module toy-server.wasm --policy policy.yaml --audit audit.jsonl\r\n  (piping in a client session: initialize, tools/list, three tools/call requests)\r\n\r\n"]
[0.229253, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"capabilities\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"tools\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"protocolVersion\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2025-06-18\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"serverInfo\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"toolcage\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"0.1.0\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.230195, "o", "\r\n"]
[0.233882, "o", "# tools/list -> policy-filtered: only echo + read_file are visible (write_file exists in the guest but is hidden)\r\n"]
[0.236712, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"tools\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Echo the text argument back.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"inputSchema\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"properties\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"text\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"string\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"required\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"text\"\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"object\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"echo\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"description\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Read a file by path and return its contents.\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"inputSchema\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"properties\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"string\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"required\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"path\"\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"object\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"read_file\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.236906, "o", "\r\n"]
[0.240479, "o", "# read_file /data/hello.txt -> inside the ro mount, succeeds\r\n"]
[0.243232, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"text\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"hello from the cage\\n\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"text\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"isError\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mfalse\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.243383, "o", "\r\n"]
[0.247088, "o", "# read_file /data/escape-link -> a symlink INSIDE the mount pointing OUTSIDE it, at the host secret\r\n"]
[0.250871, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m4\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"content\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"text\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"read error for /data/escape-link: Operation not permitted (os error 63)\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"text\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"isError\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.251104, "o", "\r\n"]
[0.255566, "o", "# write_file -> not listed in policy.yaml at all: denied before the guest ever runs\r\n"]
[0.2584, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"error\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m-32003\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"tool \\\"write_file\\\" is not listed in the policy (default deny)\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"id\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m5\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"jsonrpc\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2.0\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.258647, "o", "\r\n"]
[0.258859, "o", "$ tail -3 audit.jsonl | jq -c .    # metadata only — hashes and outcomes, never contents\r\n"]
[0.262509, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"args_bytes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m28\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"args_sha256\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"e14bddb9dce085db94d259633714f17427b2dd0efb93863a85bb8f06d0a0711d\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"decision\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"allow\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"duration_ms\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"event\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"call\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"exit_code\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"fuel_used\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m98360\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"garbage_lines\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"is_error\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"mounts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m[\u001b[0;32m\"/data:ro\"\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"outcome\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"ok\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result_bytes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m125\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"result_sha256\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"4efa288cb15ae62d329ffcf7ad659a292991f3a6590783c7c8106f4d921f21ab\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stderr_bytes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"stdout_bytes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m308\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"timeout_ms\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m20000\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"tool\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"read_file\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"ts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-08-18T01:14:53.029Z\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n\u001b[1;39m{\u001b[0m\u001b[1;34m\"args_bytes\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m41\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"args_sha256\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"59529fd3e2c1df679a7189fba87ab284c6e3d51eb5bc5af605c6c3648e831f2b\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"decision\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"deny_unlisted\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"event\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"call\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"tool\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"write_file\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"ts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-08-18T01:14:53.029Z\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.262542, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"calls\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m3\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"duration_ms\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m7\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"event\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"session_end\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"ts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-08-18T01:14:53.030Z\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.262805, "o", "\r\n$ grep -c \"TOP-SECRET\" audit.jsonl || echo \"not found\"   # the secret never touched the audit log\r\n"]
[0.264274, "o", "0\r\n"]
[0.264391, "o", "not found\r\n"]
